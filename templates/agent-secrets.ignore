# Secret files AI clients must not read (gitignore syntax).
# The installer writes these patterns into client ignore files and converts them to
# Claude Code Read deny rules; stack-specific secrets are added per detected module.
.env
.env.*
!.env.example
!.env.*.example
!.env.dist
!.env.*.dist
.envrc
.netrc
*.pem
*.p12
*.pfx
*.private.key
id_rsa*
id_ed25519*
/secrets/
/.secrets/
