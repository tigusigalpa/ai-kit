include VERSION LICENSE AGENTS.md PROJECT_CONTEXT.md README.md WIKI.md CHANGELOG.md SECURITY.md SKILL.md BOOTSTRAP_PROMPT.md CONTRIBUTING.md
include .gitignore .gitattributes
include pyproject.toml Makefile MANIFEST.in
recursive-include ai-kit *.md
prune ai-kit/.metrics
prune ai-kit/.upstream-cache
recursive-include .agents *
recursive-include tests *.py *.json *.ps1
recursive-include docs *
recursive-include integrations *
recursive-include template *
recursive-include template/.agents *
recursive-include templates *
recursive-include .github *
