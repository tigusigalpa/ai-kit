# Closed build context: kit sources only, never an application or personal configuration.
**
!Dockerfile
!.dockerignore
!.gitignore
!.gitattributes
!VERSION
!LICENSE
!README.md
!CHANGELOG.md
!SECURITY.md
!SKILL.md
!BOOTSTRAP_PROMPT.md
!CONTRIBUTING.md
!Makefile
!pyproject.toml
!MANIFEST.in
!aikit_cli.py
!__init__.py
!scripts/
!scripts/*.py
!tests/
!tests/*.py
!tests/fixtures/
!tests/fixtures/**
!template/
!template/**
!templates/
!templates/**
!integrations/
!integrations/**
!docs/
!docs/**
!ai-kit/
!ai-kit/**
!.agents/
!.agents/skills/
!.agents/skills/**
!.github/
!.github/workflows/
!.github/workflows/check-kit.yml
!docker/
!docker/build-requirements.txt
!docker/check_version.py
!deploy/
!deploy/k8s/
!deploy/k8s/*.yaml

# These exclusions win even inside an allowed source directory.
**/.git
**/.git/**
**/.env
**/.env.*
**/.aws
**/.aws/**
**/.codex
**/.codex/**
**/.claude
**/.claude/**
**/.secrets
**/.secrets/**
**/auth.json
**/.netrc
**/.pypirc
**/*.pem
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
**/__pycache__
**/__pycache__/**
**/*.py[cod]
**/*.egg-info
**/*.egg-info/**
**/build
**/build/**
**/dist
**/dist/**
ai-kit/.metrics
ai-kit/.metrics/**
ai-kit/.memory
ai-kit/.memory/**
ai-kit/.upstream-cache
ai-kit/.upstream-cache/**
ai-kit/.design
ai-kit/.design/**
docs/.private
docs/.private/**
